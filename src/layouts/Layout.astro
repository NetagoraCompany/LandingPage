<style is:global>
	@import "tailwindcss";
	@plugin "@midudev/tailwind-animations";
	
	html {
		font-family: 'Inter', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
		scroll-behavior: smooth;
	}
	
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
		background-color: #ffffff;
	}
	
	* {
		box-sizing: border-box;
	}
	
	/* ========== ANIMACIONES DE SCROLL ========== */
	
	/* Estado inicial: elementos ocultos */
	.fade-in-up {
		opacity: 0;
		transform: translateY(50px);
		transition: opacity 0.8s ease-out, transform 0.8s ease-out;
	}
	
	.fade-in-left {
		opacity: 0;
		transform: translateX(-50px);
		transition: opacity 0.8s ease-out, transform 0.8s ease-out;
	}
	
	.fade-in-right {
		opacity: 0;
		transform: translateX(50px);
		transition: opacity 0.8s ease-out, transform 0.8s ease-out;
	}
	
	.fade-in {
		opacity: 0;
		transition: opacity 1s ease-out;
	}
	
	.scale-in {
		opacity: 0;
		transform: scale(0.9);
		transition: opacity 0.6s ease-out, transform 0.6s ease-out;
	}
	
	/* Estado visible: cuando entran al viewport */
	.fade-in-up.visible,
	.fade-in-left.visible,
	.fade-in-right.visible {
		opacity: 1;
		transform: translate(0, 0);
	}
	
	.fade-in.visible {
		opacity: 1;
	}
	
	.scale-in.visible {
		opacity: 1;
		transform: scale(1);
	}
	
	/* Delays para efectos escalonados */
	.delay-100 { transition-delay: 0.05s; }
	.delay-200 { transition-delay: 0.1s; }
	.delay-300 { transition-delay: 0.15s; }
	.delay-400 { transition-delay: 0.2s; }
	.delay-500 { transition-delay: 0.25s; }
	.delay-600 { transition-delay: 0.3s; }
</style>
