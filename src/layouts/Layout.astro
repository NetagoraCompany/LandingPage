	<body class="antialiased">
		<slot />
		
		<!-- Botón flotante para volver arriba -->
		<button id="scroll-to-top" class="fixed bottom-8 right-8 z-50 w-14 h-14 bg-gradient-to-r from-purple-600 to-violet-600 text-white rounded-full shadow-lg hover:shadow-xl hover:shadow-purple-300 transition-all hover:scale-110 flex items-center justify-center opacity-0 pointer-events-none" aria-label="Volver arriba">
			<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
				<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 10l7-7m0 0l7 7m-7-7v18"></path>
			</svg>
		</button>
		
		<script>
			// Mostrar/ocultar botón de scroll to top
			const scrollToTopBtn = document.getElementById('scroll-to-top');
			
			window.addEventListener('scroll', () => {
				const currentScrollY = window.scrollY;
				
				// Mostrar el botón cuando el usuario baje más de 300px
				if (currentScrollY > 300) {
					scrollToTopBtn?.classList.remove('opacity-0', 'pointer-events-none');
					scrollToTopBtn?.classList.add('opacity-100', 'pointer-events-auto');
				} else {
					scrollToTopBtn?.classList.add('opacity-0', 'pointer-events-none');
					scrollToTopBtn?.classList.remove('opacity-100', 'pointer-events-auto');
				}
			});
			
			// Volver arriba suavemente al hacer clic
			scrollToTopBtn?.addEventListener('click', () => {
				window.scrollTo({
					top: 0,
					behavior: 'smooth'
				});
			});
			
			// ========== SISTEMA DE ANIMACIONES AL HACER SCROLL ==========
			
			// Configuración del observador
			const observerOptions = {
				threshold: 0.1, // El elemento debe ser 10% visible
				rootMargin: '0px 0px -50px 0px' // Activa 50px antes de entrar al viewport
			};
			
			// Crear el observador
			const observer = new IntersectionObserver((entries) => {
				entries.forEach(entry => {
					if (entry.isIntersecting) {
						// Agregar clase 'visible' cuando el elemento entra al viewport
						entry.target.classList.add('visible');
						// Opcional: dejar de observar después de la animación
						observer.unobserve(entry.target);
					}
				});
			}, observerOptions);
			
			// Observar todos los elementos con clases de animación
			const animatedElements = document.querySelectorAll(
				'.fade-in-up, .fade-in-left, .fade-in-right, .fade-in, .scale-in'
			);
			
			animatedElements.forEach(el => observer.observe(el));
			
			// Animar elementos que ya están visibles al cargar
			window.addEventListener('load', () => {
				animatedElements.forEach(el => {
					const rect = el.getBoundingClientRect();
					if (rect.top < window.innerHeight && rect.bottom > 0) {
						el.classList.add('visible');
					}
				});
			});
		</script>
