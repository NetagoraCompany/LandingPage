<header class="sticky top-0 z-50 backdrop-blur-md bg-white/80 border-b border-purple-100 shadow-sm">
	<nav class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="flex justify-between items-center h-20">
			<!-- Logo -->
			<div class="flex-shrink-0">
				<a href="#" class="flex items-center hover:opacity-80 transition-opacity">
					<img src="/logo.png" alt="Netagora" class="h-20 w-auto" />
				</a>
			</div>
			
			<!-- Links de navegación -->
			<div class="hidden md:flex items-center space-x-8">
				<a href="#servicios" class="text-gray-700 hover:text-purple-600 transition-colors font-medium" data-i18n="nav.services">Servicios</a>
				<a href="#proyectos" class="text-gray-700 hover:text-purple-600 transition-colors font-medium" data-i18n="nav.projects">Proyectos</a>
				<a href="#nosotros" class="text-gray-700 hover:text-purple-600 transition-colors font-medium" data-i18n="nav.about">Nosotros</a>
				<a href="#workflow" class="text-gray-700 hover:text-purple-600 transition-colors font-medium" data-i18n="nav.process">Proceso</a>
				<a href="#testimonios" class="text-gray-700 hover:text-purple-600 transition-colors font-medium" data-i18n="nav.testimonials">Testimonios</a>
				<a href="#faq" class="text-gray-700 hover:text-purple-600 transition-colors font-medium">FAQ</a>
			</div>
			
			<!-- Botón de idioma y CTA -->
			<div class="hidden md:flex items-center space-x-4">
				<button id="lang-toggle" class="flex items-center gap-2 px-4 py-2 text-gray-700 hover:text-purple-600 transition-colors font-medium border border-purple-200 rounded-lg hover:bg-purple-50">
					<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129"></path>
					</svg>
					<span id="lang-text">EN</span>
				</button>
				<a href="#contacto" class="px-6 py-3 bg-gradient-to-r from-purple-600 to-violet-600 text-white rounded-xl font-semibold hover:shadow-lg hover:shadow-purple-300 transition-all hover:scale-105" data-i18n="nav.cta">
					Cotizar Proyecto
				</a>
			</div>
			
			<!-- Botón idioma y menú móvil -->
			<div class="md:hidden flex items-center gap-2">
				<button id="lang-toggle-mobile" class="text-gray-700 hover:text-purple-600 p-2">
					<span id="lang-text-mobile" class="font-semibold">EN</span>
				</button>
				<button class="text-gray-700 hover:text-purple-600" id="mobile-menu-button">
					<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
						<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
					</svg>
				</button>
			</div>
		</div>
		
		<!-- Menú móvil -->
		<div class="md:hidden hidden" id="mobile-menu">
			<div class="px-2 pt-2 pb-3 space-y-1">
				<a href="#servicios" class="block px-3 py-2 text-gray-700 hover:text-purple-600 hover:bg-purple-50 rounded-lg" data-i18n="nav.services">Servicios</a>
				<a href="#proyectos" class="block px-3 py-2 text-gray-700 hover:text-purple-600 hover:bg-purple-50 rounded-lg" data-i18n="nav.projects">Proyectos</a>
				<a href="#nosotros" class="block px-3 py-2 text-gray-700 hover:text-purple-600 hover:bg-purple-50 rounded-lg" data-i18n="nav.about">Nosotros</a>
				<a href="#workflow" class="block px-3 py-2 text-gray-700 hover:text-purple-600 hover:bg-purple-50 rounded-lg" data-i18n="nav.process">Proceso</a>
				<a href="#testimonios" class="block px-3 py-2 text-gray-700 hover:text-purple-600 hover:bg-purple-50 rounded-lg" data-i18n="nav.testimonials">Testimonios</a>
				<a href="#faq" class="block px-3 py-2 text-gray-700 hover:text-purple-600 hover:bg-purple-50 rounded-lg">FAQ</a>
				<a href="#contacto" class="block px-3 py-2 text-center mt-2 bg-gradient-to-r from-purple-600 to-violet-600 text-white rounded-lg font-semibold" data-i18n="nav.cta">Cotizar Proyecto</a>
			</div>
		</div>
	</nav>
</header>

<script>
	// Menú móvil
	document.getElementById('mobile-menu-button')?.addEventListener('click', () => {
		const menu = document.getElementById('mobile-menu');
		menu?.classList.toggle('hidden');
	});
	
	// Sistema de traducción
	let currentLang = localStorage.getItem('lang') || 'es';
	
	const translations = {
		es: {
			'nav.services': 'Servicios',
			'nav.projects': 'Proyectos',
			'nav.about': 'Nosotros',
			'nav.process': 'Proceso',
			'nav.testimonials': 'Testimonios',
			'nav.cta': 'Cotizar Proyecto'
		},
		en: {
			'nav.services': 'Services',
			'nav.projects': 'Projects',
			'nav.about': 'About',
			'nav.process': 'Process',
			'nav.testimonials': 'Testimonials',
			'nav.cta': 'Get a Quote'
		}
	};
	
	function translatePage(lang) {
		document.querySelectorAll('[data-i18n]').forEach(element => {
			const key = element.getAttribute('data-i18n');
			if (translations[lang] && translations[lang][key]) {
				element.textContent = translations[lang][key];
			}
		});
		
		// Actualizar texto del botón
		document.getElementById('lang-text').textContent = lang === 'es' ? 'EN' : 'ES';
		document.getElementById('lang-text-mobile').textContent = lang === 'es' ? 'EN' : 'ES';
		
		// Disparar evento personalizado para que otras secciones se actualicen
		window.dispatchEvent(new CustomEvent('languageChange', { detail: { lang } }));
	}
	
	// Aplicar idioma guardado al cargar
	translatePage(currentLang);
	
	// Cambiar idioma
	function toggleLanguage() {
		currentLang = currentLang === 'es' ? 'en' : 'es';
		localStorage.setItem('lang', currentLang);
		translatePage(currentLang);
	}
	
	document.getElementById('lang-toggle')?.addEventListener('click', toggleLanguage);
	document.getElementById('lang-toggle-mobile')?.addEventListener('click', toggleLanguage);
</script>