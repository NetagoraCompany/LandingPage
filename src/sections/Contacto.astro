					<div class="flex space-x-4">
						<a href="https://www.instagram.com/netagora.co/" target="_blank" class="w-12 h-12 bg-purple-100 hover:bg-purple-600 text-purple-600 hover:text-white rounded-lg flex items-center justify-center transition-all">
							<svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
