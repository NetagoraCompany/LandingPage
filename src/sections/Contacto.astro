					</div>
					<div class="ml-4">
						<h4 class="text-lg font-semibold text-gray-900 mb-1" data-i18n="contact.info.location">Ubicación</h4>
						<p class="text-gray-600" data-i18n="contact.info.location.desc">
							Cali, Colombia<br>
							Trabajamos de forma remota con clientes en todo el mundo
						</p>
					</div>
				</div>
				
