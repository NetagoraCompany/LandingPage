<section id="contacto" class="py-20 bg-slate-50">
	<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<!-- Encabezado -->
		<div class="text-center mb-16 fade-in-up">
			<h2 class="text-4xl sm:text-5xl font-bold text-gray-900 mb-4">
				<span data-i18n="contact.title">¿Listo para</span> <span class="bg-gradient-to-r from-purple-600 to-violet-600 bg-clip-text text-transparent" data-i18n="contact.title2">Comenzar</span>?
			</h2>
			<p class="text-xl text-gray-600" data-i18n="contact.subtitle">
				Contáctanos y transformemos tu idea en realidad
			</p>
			</div>
		
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
			<!-- Formulario -->
			<div class="bg-white rounded-2xl p-8 shadow-lg border border-purple-100 fade-in-left delay-100">
				<h3 class="text-2xl font-bold text-gray-900 mb-6" data-i18n="contact.form.title">Envíanos un mensaje</h3>
				
				<form id="contact-form" class="space-y-6">
					<!-- Nombre -->
					<div>
						<label for="name" class="block text-sm font-medium text-gray-700 mb-2" data-i18n="contact.form.name">Nombre completo</label>
						<input 
							type="text" 
							id="name" 
							name="name" 
							required 
							class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-600 focus:border-transparent transition-all"
							placeholder="Juan Pérez"
							data-i18n-placeholder="contact.form.name.placeholder"
						/>
					</div>
					
					<!-- Email -->
					<div>
						<label for="email" class="block text-sm font-medium text-gray-700 mb-2" data-i18n="contact.form.email">Email</label>
						<input 
							type="email" 
							id="email" 
							name="email" 
							required 
							class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-600 focus:border-transparent transition-all"
							placeholder="juan@empresa.com"
							data-i18n-placeholder="contact.form.email.placeholder"
						/>
					</div>
					
					<!-- Teléfono -->
					<div>
						<label for="phone" class="block text-sm font-medium text-gray-700 mb-2" data-i18n="contact.form.phone">Teléfono (opcional)</label>
						<input 
							type="tel" 
							id="phone" 
							name="phone" 
							class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-600 focus:border-transparent transition-all"
							placeholder="+57 321 743 8901"
						/>
					</div>
					
					<!-- Servicio -->
					<div>
						<label for="service" class="block text-sm font-medium text-gray-700 mb-2" data-i18n="contact.form.service">Servicio de interés</label>
						<select 
							id="service" 
							name="service" 
							required
							class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-600 focus:border-transparent transition-all"
						>
							<option value="" data-i18n="contact.form.service.select">Selecciona un servicio</option>
							<option value="web" data-i18n="contact.form.service.web">Aplicación Web</option>
							<option value="mobile" data-i18n="contact.form.service.mobile">Aplicación Móvil</option>
							<option value="ecommerce" data-i18n="contact.form.service.ecommerce">E-commerce</option>
							<option value="crm" data-i18n="contact.form.service.crm">CRM/ERP</option>
							<option value="saas" data-i18n="contact.form.service.saas">Plataforma SaaS</option>
							<option value="other" data-i18n="contact.form.service.other">Otro</option>
						</select>
					</div>
					
					<!-- Mensaje -->
					<div>
						<label for="message" class="block text-sm font-medium text-gray-700 mb-2" data-i18n="contact.form.message">Mensaje</label>
						<textarea 
							id="message" 
							name="message" 
							rows="4" 
							required
							class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-purple-600 focus:border-transparent transition-all resize-none"
							placeholder="Cuéntanos sobre tu proyecto..."
							data-i18n-placeholder="contact.form.message.placeholder"
						></textarea>
					</div>
					
					<!-- Botón -->
					<button 
						type="submit" 
						id="submit-btn"
						class="w-full px-8 py-4 bg-gradient-to-r from-purple-600 to-violet-600 text-white rounded-xl font-bold text-lg hover:shadow-lg hover:shadow-purple-300 transition-all hover:scale-105 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:scale-100"
						data-i18n="contact.form.submit"
					>
						Enviar Mensaje
					</button>
				</form>
			</div>
			
			<!-- Información de contacto -->
			<div class="space-y-8 fade-in-right delay-200">
				<div>
					<h3 class="text-2xl font-bold text-gray-900 mb-6" data-i18n="contact.info.title">Información de contacto</h3>
					<p class="text-gray-600 mb-8" data-i18n="contact.info.desc">
						También puedes contactarnos directamente a través de estos medios:
					</p>
				</div>
				
