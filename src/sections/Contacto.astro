</section>

<script>
	const form = document.getElementById('contact-form') as HTMLFormElement;
	const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
	
	// Número de WhatsApp (formato internacional sin + ni espacios)
	const WHATSAPP_NUMBER = '573154478029';
	
	// Textos en diferentes idiomas
	const messages = {
		es: {
			sending: 'Redirigiendo a WhatsApp...',
			submit: 'Enviar Mensaje',
			whatsappIntro: '¡Hola! Me gustaría solicitar una cotización:',
			name: 'Nombre',
			email: 'Email',
			phone: 'Teléfono',
			service: 'Servicio',
			message: 'Mensaje'
		},
		en: {
			sending: 'Redirecting to WhatsApp...',
			submit: 'Send Message',
			whatsappIntro: 'Hello! I would like to request a quote:',
			name: 'Name',
			email: 'Email',
			phone: 'Phone',
			service: 'Service',
			message: 'Message'
		}
	};
	
	// Obtener idioma actual
	function getCurrentLang() {
		return localStorage.getItem('lang') || 'es';
	}
	
	form?.addEventListener('submit', (e) => {
		e.preventDefault();
		
		const lang = getCurrentLang();
		
		// Cambiar texto del botón
		submitBtn.disabled = true;
		submitBtn.textContent = messages[lang].sending;
		
		// Obtener datos del formulario
		const formData = new FormData(form);
		const name = formData.get('name');
		const email = formData.get('email');
		const phone = formData.get('phone');
		const service = formData.get('service');
		const message = formData.get('message');
		
		// Construir mensaje de WhatsApp
		let whatsappMessage = `${messages[lang].whatsappIntro}\n\n`;
		whatsappMessage += `*${messages[lang].name}:* ${name}\n`;
		whatsappMessage += `*${messages[lang].email}:* ${email}\n`;
		if (phone) whatsappMessage += `*${messages[lang].phone}:* ${phone}\n`;
		whatsappMessage += `*${messages[lang].service}:* ${service}\n\n`;
		whatsappMessage += `*${messages[lang].message}:*\n${message}`;
		
		// Codificar el mensaje para URL
		const encodedMessage = encodeURIComponent(whatsappMessage);
		
		// Abrir WhatsApp
		window.open(`https://wa.me/${WHATSAPP_NUMBER}?text=${encodedMessage}`, '_blank');
		
		// Resetear formulario y botón
		setTimeout(() => {
			form.reset();
			submitBtn.disabled = false;
			submitBtn.textContent = messages[lang].submit;
		}, 1000);
	});
</script>